{
  "name": "recorte",
  "version": "0.1.49",
  "private": true,
  "description": "El editor de video que maneja tu agente de IA.",
  "author": "reninn34-arch",
  "main": "./out/main/index.js",
  "license": "SEE LICENSE IN LICENSE",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "prueba:e2e": "npm run build && node scripts/prueba-e2e.mjs",
    "prueba:agente": "node scripts/prueba-agente.mjs",
    "prueba:crear": "node scripts/prueba-crear.mjs",
    "prueba:estilo": "node scripts/prueba-estilo.mjs",
    "package": "electron-vite build && node scripts/licencia-instalador.mjs && electron-builder",
    "prueba:modo-agente": "node scripts/prueba-modo-agente.mjs",
    "prueba:kit": "node scripts/prueba-kit.mjs",
    "prueba:versiones": "node --experimental-strip-types --no-warnings --import ./scripts/ts-sin-extension.mjs scripts/prueba-versiones.mjs",
    "prueba:adaptadores": "node --experimental-strip-types --no-warnings scripts/prueba-adaptadores.mjs",
    "prueba:exportar": "node --experimental-strip-types --no-warnings --import ./scripts/ts-sin-extension.mjs --import ./scripts/electron-falso.mjs scripts/prueba-exportar.mjs",
    "prueba:mcp": "node --experimental-strip-types --no-warnings --import ./scripts/ts-sin-extension.mjs --import ./scripts/electron-falso.mjs scripts/prueba-mcp.mjs",
    "prueba:catalogo": "node --experimental-strip-types --no-warnings --import ./scripts/ts-sin-extension.mjs --import ./scripts/electron-falso.mjs scripts/prueba-catalogo.mjs",
    "prueba:retoques": "node --experimental-strip-types --no-warnings --import ./scripts/ts-sin-extension.mjs --import ./scripts/electron-falso.mjs scripts/prueba-retoques.mjs",
    "prueba:edicion": "node --experimental-strip-types --no-warnings --import ./scripts/ts-sin-extension.mjs scripts/prueba-edicion.mjs",
    "prueba:estabilizar": "node --experimental-strip-types --no-warnings --import ./scripts/ts-sin-extension.mjs --import ./scripts/electron-falso.mjs scripts/prueba-estabilizar.mjs",
    "prueba:multicam": "node --experimental-strip-types --no-warnings --import ./scripts/ts-sin-extension.mjs --import ./scripts/electron-falso.mjs scripts/prueba-multicam.mjs",
    "prueba:modelos": "node --experimental-strip-types --no-warnings --import ./scripts/ts-sin-extension.mjs --import ./scripts/electron-falso.mjs scripts/prueba-modelos.mjs",
    "prueba:medios": "node --experimental-strip-types --no-warnings --import ./scripts/ts-sin-extension.mjs scripts/prueba-medios.mjs"
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "lucide-react": "^1.70.0",
    "playwright-core": "^1.65.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "electron": "^45.2.2",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/reninn34-arch/recorte.git"
  }
}
